DARWIN_LOG_FILE := "/tmp/darwin-setup.log"
DARWIN_TEMP_DIR := "/tmp/dotfiles-darwin-setup"
DARWIN_FONTS_TEMP_DIR := "$(DARWIN_TEMP_DIR)/terminal-fonts"
DARWIN_NEOVIM_TEMP_DIR := "$(DARWIN_TEMP_DIR)/neovim"

.PHONY: darwin-pre-setup darwin-xcode darwin-homebrew darwin-install-stow darwin-stow darwin-homebrew-packages darwin-alacritty darwin-terminus-font darwin-tmux-tpm darwin-tmux-plugins darwin-oh-my-zsh darwin-zsh-theme darwin-zshrc darwin-neovim darwin-complete darwin-setup

darwin-pre-setup:
	@echo "Setting up dotfiles for macOS (darwin)"
	@echo "writing log files to ${DARWIN_LOG_FILE}...\n"

darwin-xcode:
	@echo "Checking if xcode-select is installed"
	@if command -v xcode-select >/dev/null 2>&1; then \
		echo "✓ xcode-select found at $$(command -v xcode-select)"; \
		echo "Installing Xcode command line tools if needed..."; \
		echo "Xcode installation output is being logged to $(DARWIN_LOG_FILE)"; \
		xcode-select --install >> $(DARWIN_LOG_FILE) 2>&1 || echo "Xcode command line tools already installed"; \
	else \
		echo "✗ xcode-select not found"; \
		echo "Please install Xcode from the App Store or run: xcode-select --install"; \
		exit 1; \
	fi

darwin-homebrew:
	@echo "Checking if Homebrew is installed"
	@if command -v brew >/dev/null 2>&1; then \
		echo "✓ Homebrew found at $$(command -v brew)"; \
		echo "Updating Homebrew..."; \
		brew update; \
	else \
		echo "✗ Homebrew not found"; \
		echo "Installing Homebrew..."; \
		/bin/bash -c "$$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; \
	fi

darwin-install-stow:
	@echo "Checking if stow is installed"
	@if command -v stow >/dev/null 2>&1; then \
		echo "✓ stow already installed at $$(command -v stow)"; \
	else \
		echo "Installing stow via Homebrew..."; \
		brew install stow; \
		echo "✓ stow installed successfully"; \
	fi

darwin-stow:
	@echo "Stowing dotfiles directories..."
	@stow -t $(HOME) alacritty-darwin gitconfig homebrew nvim tmux vim zsh
	@echo "✓ Dotfiles stowed successfully"

darwin-homebrew-packages:
	@echo "Checking for Homebrew packages to install"
	@if [ -f ~/.Brewfile ]; then \
		echo "✓ .Brewfile found in home directory"; \
		echo "Installing packages from .Brewfile..."; \
		echo "Package installation output is being logged to $(DARWIN_LOG_FILE)"; \
		brew bundle --global >> $(DARWIN_LOG_FILE) 2>&1; \
		echo "✓ Homebrew packages installed successfully"; \
	else \
		echo "✗ No .Brewfile found in home directory"; \
		echo "Skipping Homebrew package installation"; \
	fi

darwin-alacritty:
	@echo "Checking if Alacritty is installed"
	@if [ -d /Applications/Alacritty.app ]; then \
		echo "✓ Alacritty found at /Applications/Alacritty.app"; \
	else \
		echo "✗ Alacritty not found (the Homebrew cask was disabled because it fails Gatekeeper)"; \
		echo "  1. Download the latest .dmg from https://github.com/alacritty/alacritty/releases"; \
		echo "  2. Drag Alacritty.app into /Applications"; \
		echo "  3. If macOS blocks it, run: xattr -dr com.apple.quarantine /Applications/Alacritty.app"; \
		while [ ! -d /Applications/Alacritty.app ]; do \
			printf "Press Enter once Alacritty is installed (or type 'skip'): "; \
			read -r answer; \
			if [ "$$answer" = "skip" ]; then echo "Skipping Alacritty installation"; break; fi; \
			[ -d /Applications/Alacritty.app ] || echo "✗ /Applications/Alacritty.app still not found"; \
		done; \
		if [ -d /Applications/Alacritty.app ]; then echo "✓ Alacritty installed"; fi; \
	fi

darwin-terminus-font:
	@echo "Checking if Terminus fonts are installed"
	@if ls ~/Library/Fonts/*Terminess* >/dev/null 2>&1; then \
		echo "✓ Terminus fonts already installed"; \
		ls ~/Library/Fonts/*Terminess* | wc -l | xargs echo "Found" | sed 's/$$/ font files/'; \
	else \
		echo "Installing Terminus fonts"; \
		mkdir -p $(DARWIN_FONTS_TEMP_DIR); \
		echo "Extracting terminus-font.zip from setup/resources..."; \
		cp setup/resources/terminus-font.zip $(DARWIN_FONTS_TEMP_DIR)/; \
		cd $(DARWIN_FONTS_TEMP_DIR) && unzip -q terminus-font.zip; \
		echo "Installing TTF fonts to ~/Library/Fonts..."; \
		find $(DARWIN_FONTS_TEMP_DIR) -name "*.ttf" -exec cp {} ~/Library/Fonts/ \;; \
		echo "✓ Terminus fonts installed successfully"; \
		echo "Cleaning up temporary files..."; \
		rm -rf $(DARWIN_FONTS_TEMP_DIR); \
	fi

darwin-tmux-tpm:
	@echo "Checking if TMUX Plugin Manager is installed"
	@if [ -d ~/.tmux/plugins/tpm ]; then \
		echo "✓ TMUX Plugin Manager already installed"; \
	else \
		echo "Installing TMUX Plugin Manager..."; \
		mkdir -p ~/.tmux/plugins; \
		git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm; \
		echo "✓ TMUX Plugin Manager installed successfully"; \
	fi
	@echo "Refreshing tmux environment..."
	@tmux source ~/.tmux.conf || echo "Note: tmux not running or config not found"

darwin-tmux-plugins:
	@echo "Installing tmux plugins..."
	@if [ -f ~/.tmux/plugins/tpm/bin/install_plugins ]; then \
		sh ~/.tmux/plugins/tpm/bin/install_plugins; \
		echo "✓ tmux plugins installed successfully"; \
	else \
		echo "✗ TPM install script not found. Make sure darwin-tmux-tpm target ran successfully"; \
		exit 1; \
	fi

darwin-oh-my-zsh:
	@echo "Checking if Oh My Zsh is installed"
	@if [ -d ~/.oh-my-zsh ]; then \
		echo "✓ Oh My Zsh already installed"; \
	else \
		echo "Installing Oh My Zsh..."; \
		sh -c "$$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended --keep-zshrc; \
		echo "✓ Oh My Zsh installed successfully"; \
	fi

darwin-zsh-theme:
	@echo "Linking custom zsh theme from oh-my-zsh/"
	@mkdir -p ~/.oh-my-zsh/custom/themes
	@ln -sf "$(CURDIR)/oh-my-zsh/devsdmf.zsh-theme" ~/.oh-my-zsh/custom/themes/devsdmf.zsh-theme
	@echo "✓ Custom zsh theme linked to ~/.oh-my-zsh/custom/themes/devsdmf.zsh-theme"

darwin-zshrc:
	@sh setup/scripts/zshrc.sh
darwin-neovim:
	@echo "Checking if NeoVim is installed"
	@if command -v nvim >/dev/null 2>&1; then \
		echo "✓ NeoVim already installed at $$(command -v nvim)"; \
		nvim --version | head -1; \
	else \
		echo "Installing NeoVim from source"; \
		mkdir -p $(DARWIN_NEOVIM_TEMP_DIR); \
		echo "Cloning NeoVim repository..."; \
		git clone https://github.com/neovim/neovim $(DARWIN_NEOVIM_TEMP_DIR) >> $(DARWIN_LOG_FILE) 2>&1; \
		cd $(DARWIN_NEOVIM_TEMP_DIR) && git checkout stable >> $(DARWIN_LOG_FILE) 2>&1; \
		echo "Building NeoVim (this may take a while)..."; \
		echo "Build output is being logged to $(DARWIN_LOG_FILE)"; \
		cd $(DARWIN_NEOVIM_TEMP_DIR) && make CMAKE_BUILD_TYPE=RelWithDebInfo >> $(DARWIN_LOG_FILE) 2>&1; \
		echo "Installing NeoVim (may require sudo password)..."; \
		cd $(DARWIN_NEOVIM_TEMP_DIR) && sudo make install >> $(DARWIN_LOG_FILE) 2>&1; \
		echo "✓ NeoVim installed successfully"; \
		echo "Cleaning up temporary files..."; \
		sudo rm -rf $(DARWIN_NEOVIM_TEMP_DIR) >> $(DARWIN_LOG_FILE) 2>&1; \
	fi
	@echo "Creating NeoVim data directory"
	@mkdir -p ~/.local/share/nvim
	@echo "✓ NeoVim setup complete"

darwin-complete:
	@echo ""
	@echo "🎉 macOS dotfiles setup completed successfully!"
	@echo ""
	@echo "Summary of what was installed/configured:"
	@echo "  ✓ Xcode command line tools"
	@echo "  ✓ Homebrew package manager"
	@echo "  ✓ GNU Stow for dotfiles management"
	@echo "  ✓ Dotfiles symlinked to home directory"
	@echo "  ✓ Homebrew packages (if .Brewfile exists)"
	@echo "  ✓ Alacritty (manual install)"
	@echo "  ✓ Terminus fonts"
	@echo "  ✓ TMUX Plugin Manager"
	@echo "  ✓ TMUX plugins"
	@echo "  ✓ Oh My Zsh framework"
	@echo "  ✓ Custom zsh theme"
	@echo "  ✓ Machine-specific ~/.zshrc sourcing ~/.devsdmf.zshrc"
	@echo "  ✓ NeoVim editor"
	@echo ""
	@echo "Next steps:"
	@echo "  • Restart your terminal or run: exec zsh"
	@echo "  • Check the log file for details: $(DARWIN_LOG_FILE)"
	@echo "  • Enjoy your new development environment! 🚀"
	@echo ""

darwin-setup: darwin-pre-setup darwin-xcode darwin-homebrew darwin-install-stow darwin-stow darwin-homebrew-packages darwin-alacritty darwin-terminus-font darwin-tmux-tpm darwin-tmux-plugins darwin-oh-my-zsh darwin-zsh-theme darwin-zshrc darwin-neovim darwin-complete
