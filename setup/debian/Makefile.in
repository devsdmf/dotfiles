DEBIAN_LOG_FILE := "/tmp/debian-setup.log"
DEBIAN_TEMP_DIR := "/tmp/dotfiles-debian-setup"
DEBIAN_FONTS_TEMP_DIR := "$(DEBIAN_TEMP_DIR)/terminal-fonts"
DEBIAN_NEOVIM_TEMP_DIR := "$(DEBIAN_TEMP_DIR)/neovim"

.PHONY: debian-pre-setup debian-build-essential debian-apt-update debian-install-stow debian-stow debian-apt-packages debian-terminus-font debian-tmux-tpm debian-tmux-plugins debian-oh-my-zsh debian-zsh-theme debian-zsh-restore debian-neovim debian-complete debian-setup

debian-pre-setup:
	@echo "Setting up dotfiles for Debian/Ubuntu (debian)"
	@echo "writing log files to ${DEBIAN_LOG_FILE}...\n"

debian-build-essential:
	@echo "Checking if build-essential is installed"
	@if dpkg -l | grep -q build-essential; then \
		echo "✓ build-essential already installed"; \
	else \
		echo "Installing build-essential..."; \
		echo "Build tools installation output is being logged to $(DEBIAN_LOG_FILE)"; \
		sudo apt-get install -y build-essential >> $(DEBIAN_LOG_FILE) 2>&1; \
		echo "✓ build-essential installed successfully"; \
	fi

debian-apt-update:
	@echo "Updating package lists..."
	@echo "APT update output is being logged to $(DEBIAN_LOG_FILE)"
	@sudo apt-get update >> $(DEBIAN_LOG_FILE) 2>&1
	@echo "✓ Package lists updated successfully"

debian-install-stow:
	@echo "Checking if stow is installed"
	@if command -v stow >/dev/null 2>&1; then \
		echo "✓ stow already installed at $$(command -v stow)"; \
	else \
		echo "Installing stow via APT..."; \
		sudo apt-get install -y stow; \
		echo "✓ stow installed successfully"; \
	fi

debian-stow:
	@echo "Stowing dotfiles directories..."
	@stow -t $(HOME) alacritty-debian gitconfig apt nvim tmux vim zsh
	@echo "✓ Dotfiles stowed successfully"

debian-apt-packages:
	@echo "Checking for APT packages to install"
	@if [ -f ~/.apt-packages ]; then \
		echo "✓ .apt-packages found in home directory"; \
		echo "Installing packages from .apt-packages..."; \
		echo "Package installation output is being logged to $(DEBIAN_LOG_FILE)"; \
		sudo apt-get install -y $$(sed -e 's/#.*//' ~/.apt-packages | xargs) >> $(DEBIAN_LOG_FILE) 2>&1; \
		echo "✓ APT packages installed successfully"; \
	else \
		echo "✗ No .apt-packages found in home directory"; \
		echo "Skipping APT package installation"; \
	fi

debian-terminus-font:
	@echo "Checking if Terminus fonts are installed"
	@if ls ~/.local/share/fonts/*Terminus* >/dev/null 2>&1; then \
		echo "✓ Terminus fonts already installed"; \
		ls ~/.local/share/fonts/*Terminus* | wc -l | xargs echo "Found" | sed 's/$$/ font files/'; \
	else \
		echo "Installing Terminus fonts"; \
		mkdir -p $(DEBIAN_FONTS_TEMP_DIR); \
		mkdir -p ~/.local/share/fonts; \
		echo "Extracting terminus-font.zip from setup/resources..."; \
		cp setup/resources/terminus-font.zip $(DEBIAN_FONTS_TEMP_DIR)/; \
		cd $(DEBIAN_FONTS_TEMP_DIR) && unzip -q terminus-font.zip; \
		echo "Installing TTF fonts to ~/.local/share/fonts..."; \
		find $(DEBIAN_FONTS_TEMP_DIR) -name "*.ttf" -exec cp {} ~/.local/share/fonts/ \;; \
		echo "Refreshing font cache..."; \
		fc-cache -fv >> $(DEBIAN_LOG_FILE) 2>&1; \
		echo "✓ Terminus fonts installed successfully"; \
		echo "Cleaning up temporary files..."; \
		rm -rf $(DEBIAN_FONTS_TEMP_DIR); \
	fi

debian-tmux-tpm:
	@echo "Checking if TMUX Plugin Manager is installed"
	@if [ -d ~/.tmux/plugins/tpm ]; then \
		echo "✓ TMUX Plugin Manager already installed"; \
	else \
		echo "Installing TMUX Plugin Manager..."; \
		mkdir -p ~/.tmux/plugins; \
		git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm; \
		echo "✓ TMUX Plugin Manager installed successfully"; \
	fi
	@echo "Refreshing tmux environment..."
	@tmux source ~/.tmux.conf || echo "Note: tmux not running or config not found"

debian-tmux-plugins:
	@echo "Installing tmux plugins..."
	@if [ -f ~/.tmux/plugins/tpm/bin/install_plugins ]; then \
		sh ~/.tmux/plugins/tpm/bin/install_plugins; \
		echo "✓ tmux plugins installed successfully"; \
	else \
		echo "✗ TPM install script not found. Make sure debian-tmux-tpm target ran successfully"; \
		exit 1; \
	fi

debian-oh-my-zsh:
	@echo "Checking if Oh My Zsh is installed"
	@if [ -d ~/.oh-my-zsh ]; then \
		echo "✓ Oh My Zsh already installed"; \
	else \
		echo "Installing Oh My Zsh..."; \
		sh -c "$$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended; \
		echo "✓ Oh My Zsh installed successfully"; \
	fi

debian-zsh-theme:
	@echo "Linking custom zsh theme from oh-my-zsh/"
	@mkdir -p ~/.oh-my-zsh/custom/themes
	@ln -sf "$(CURDIR)/oh-my-zsh/devsdmf.zsh-theme" ~/.oh-my-zsh/custom/themes/devsdmf.zsh-theme
	@echo "✓ Custom zsh theme linked to ~/.oh-my-zsh/custom/themes/devsdmf.zsh-theme"

debian-zsh-restore:
	@echo "Checking for Oh My Zsh backup file"
	@if [ -f ~/.zshrc.pre-oh-my-zsh ]; then \
		echo "✓ Found Oh My Zsh backup file"; \
		echo "Restoring original .zshrc from backup..."; \
		mv ~/.zshrc.pre-oh-my-zsh ~/.zshrc; \
		echo "✓ Original .zshrc restored successfully"; \
	else \
		echo "✗ No Oh My Zsh backup file found"; \
		echo "Skipping .zshrc restoration"; \
	fi

debian-neovim:
	@echo "Checking if NeoVim is installed"
	@if command -v nvim >/dev/null 2>&1; then \
		echo "✓ NeoVim already installed at $$(command -v nvim)"; \
		nvim --version | head -1; \
	else \
		echo "Installing NeoVim from source"; \
		mkdir -p $(DEBIAN_NEOVIM_TEMP_DIR); \
		echo "Cloning NeoVim repository..."; \
		git clone https://github.com/neovim/neovim $(DEBIAN_NEOVIM_TEMP_DIR) >> $(DEBIAN_LOG_FILE) 2>&1; \
		cd $(DEBIAN_NEOVIM_TEMP_DIR) && git checkout stable >> $(DEBIAN_LOG_FILE) 2>&1; \
		echo "Building NeoVim (this may take a while)..."; \
		echo "Build output is being logged to $(DEBIAN_LOG_FILE)"; \
		cd $(DEBIAN_NEOVIM_TEMP_DIR) && make CMAKE_BUILD_TYPE=RelWithDebInfo >> $(DEBIAN_LOG_FILE) 2>&1; \
		echo "Installing NeoVim (may require sudo password)..."; \
		cd $(DEBIAN_NEOVIM_TEMP_DIR) && sudo make install >> $(DEBIAN_LOG_FILE) 2>&1; \
		echo "✓ NeoVim installed successfully"; \
		echo "Cleaning up temporary files..."; \
		sudo rm -rf $(DEBIAN_NEOVIM_TEMP_DIR) >> $(DEBIAN_LOG_FILE) 2>&1; \
	fi
	@echo "Creating NeoVim data directory"
	@mkdir -p ~/.local/share/nvim
	@echo "✓ NeoVim setup complete"

debian-complete:
	@echo ""
	@echo "🎉 Debian/Ubuntu dotfiles setup completed successfully!"
	@echo ""
	@echo "Summary of what was installed/configured:"
	@echo "  ✓ Build essential tools"
	@echo "  ✓ Package lists updated"
	@echo "  ✓ GNU Stow for dotfiles management"
	@echo "  ✓ Dotfiles symlinked to home directory"
	@echo "  ✓ APT packages (if .apt-packages exists)"
	@echo "  ✓ Terminus fonts"
	@echo "  ✓ TMUX Plugin Manager"
	@echo "  ✓ TMUX plugins"
	@echo "  ✓ Oh My Zsh framework"
	@echo "  ✓ Custom zsh theme"
	@echo "  ✓ Zsh configuration restored"
	@echo "  ✓ NeoVim editor"
	@echo ""
	@echo "Next steps:"
	@echo "  • Restart your terminal or run: source ~/.zshrc"
	@echo "  • Check the log file for details: $(DEBIAN_LOG_FILE)"
	@echo "  • Enjoy your new development environment! 🚀"
	@echo ""

debian-setup: debian-pre-setup debian-build-essential debian-apt-update debian-install-stow debian-stow debian-apt-packages debian-terminus-font debian-tmux-tpm debian-tmux-plugins debian-oh-my-zsh debian-zsh-theme debian-zsh-restore debian-neovim debian-complete
